{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "ruby@3.4.1",
    "nodejs@24",
    "yarn@latest",
    "git@latest",
    "bash@latest",
    "zlib@latest",
    "pkg-config@latest",
    "libyaml@latest",
    "shared-mime-info@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "export FREEDESKTOP_MIME_TYPES_PATH=\"$(dirname $(which update-mime-database))/../share/mime/packages/freedesktop.org.xml\""
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
