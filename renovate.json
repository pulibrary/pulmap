{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "enabledManagers": [
    "asdf",
    "bundler",
    "circleci",
    "devbox",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "nodenv",
    "npm",
    "custom.regex"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": [
      "* 20-23 * * 1"
    ]
  },
  "minimumReleaseAge": "4 days",
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/postgres/"
      ]
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "ruby-version",
        "node-version"
      ],
      "minimumReleaseAge": "4 hours"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.tool-versions$/"
      ],
      "matchStrings": [
        "\\s+(?<currentValue>\\S+)\\s*#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.circleci/config.yml$/"
      ],
      "matchStrings": [
        "node-version:.*'(?<currentValue>.*?)'"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.circleci/config.yml$/"
      ],
      "matchStrings": [
        "cimg/ruby:(?<currentValue>.*?)-"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby"
    }
  ]
}
